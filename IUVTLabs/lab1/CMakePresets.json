{
  "version": 3,
  "configurePresets": [
    {
      "name": "msys2-ucrt",
      "displayName": "MSYS2 UCRT Qt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msys2-ucrt",
      "configurePreset": "msys2-ucrt"
    }
  ]
}
